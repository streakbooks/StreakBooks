# Copy to .env — fill KEYS from your Supabase project API settings.
# Never commit real .env values.
# Development / preview only until a dedicated production project is approved.

# --- Browser (Vite) — publishable only ---
VITE_SUPABASE_PROJECT_ID="ipxflpzfcqwtenodbxwc"
VITE_SUPABASE_URL="https://ipxflpzfcqwtenodbxwc.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_gIOFsOlbRfjdQA9huRZGhQ_4RfKxOoK"

# --- Sign-in options (public flags; enable the matching provider in Supabase first) ---
# Supabase settings are applied with scripts/configure-supabase-auth.sh.
# Comma list of: google, azure (Microsoft), apple, github, linkedin_oidc
# VITE_AUTH_OAUTH_PROVIDERS=
# VITE_AUTH_SSO_ENABLED=false        # SAML SSO (Supabase Pro plan + `supabase sso add`)
# VITE_AUTH_PHONE_ENABLED=false      # SMS codes (needs an SMS provider, e.g. Twilio)
# VITE_AUTH_EMAIL_CODE_ENABLED=true  # Email sign-in link (magic link)
# VITE_AUTH_EMAIL_OTP_LENGTH=0       # 6 once custom SMTP + code template are applied; 0 = link only
# Human verification: turnstile (Cloudflare) or hcaptcha. Site key only — the secret
# goes to Supabase, never here.
# VITE_CAPTCHA_PROVIDER=
# VITE_CAPTCHA_SITE_KEY=

# --- Server (TanStack Start / Vercel) — mirror URL + publishable ---
SUPABASE_PROJECT_ID="ipxflpzfcqwtenodbxwc"
SUPABASE_URL="https://ipxflpzfcqwtenodbxwc.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_gIOFsOlbRfjdQA9huRZGhQ_4RfKxOoK"
# --- Server only — NEVER prefix with VITE_ ---
# SUPABASE_SERVICE_ROLE_KEY=

# Optional cron (server only)
# LOVABLE_CRON_SECRET=

# Authenticated Playwright only. Never commit real values. Sign-in is not bypassed.
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_BASE_URL=http://127.0.0.1:8080

# --- AI Accounting Assistant (server only — NEVER VITE_*) ---
# OpenAI-compatible Chat Completions API. Leave unset for honest "not configured" UI.
# AI_API_KEY=
# OPENAI_API_KEY=   # accepted as alias for AI_API_KEY
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_MAX_REQUESTS_PER_HOUR=30
# AI_MAX_CONTEXT_CHARS=12000
# AI_MAX_OUTPUT_TOKENS=1200
