{
  "name": "streakbooks",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "check:repository": "node scripts/check-repository-hygiene.mjs && node --test scripts/check-repository-hygiene.test.mjs",
    "dev": "vite dev --port 8080 --strictPort",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:practice": "playwright test --config playwright.practice.config.ts",
    "test:corrections": "playwright test --config playwright.corrections.config.ts",
    "test:voice": "playwright test --config playwright.voice.config.ts",
    "test:wake": "playwright test --config playwright.wake.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:themes": "playwright test --config playwright.themes.config.ts",
    "test:reporting": "playwright test --config playwright.reporting.config.ts",
    "test:navigation": "playwright test --config playwright.navigation.config.ts",
    "test:platform": "playwright test --config playwright.platform.config.ts",
    "test:platform:postgres": "node scripts/test-platform-postgres.mjs",
    "test:pos:postgres": "node scripts/test-pos-postgres.mjs",
    "check:lookups": "node scripts/check-lookup-architecture.mjs",
    "check:navigation": "node scripts/check-native-navigation.mjs",
    "check:visual-coverage": "node scripts/check-premium-visual-coverage.mjs",
    "check:browsing-coverage": "node scripts/check-browsing-coverage.mjs",
    "sync:browsing-manifest": "node scripts/sync-browsing-manifest.mjs",
    "test:workflows:postgres": "node scripts/test-workflows-postgres.mjs",
    "test:documents:postgres": "node scripts/test-document-review-postgres.mjs",
    "test:accountant:postgres": "node scripts/test-accountant-exceptions-postgres.mjs",
    "test:correction-approvals:postgres": "node scripts/test-correction-approvals-postgres.mjs",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:workpaper-items:postgres": "node scripts/test-accountant-workpaper-items-postgres.mjs",
    "test:billing:postgres": "node scripts/test-billing-postgres.mjs",
    "check:ui": "node scripts/check-ui-contracts.mjs",
    "audit:ui": "node scripts/check-ui-contracts.mjs --write-audit",
    "check:modules": "node scripts/check-module-permissions.mjs && node scripts/check-module-contracts.mjs && node scripts/check-workspace-adoption.mjs && node scripts/check-empty-state-honesty.mjs && node scripts/check-error-state-retry.mjs",
    "scaffold:module": "node scripts/scaffold-module.mjs",
    "check:workspace": "node scripts/check-workspace-adoption.mjs",
    "check:empty": "node scripts/check-empty-state-honesty.mjs",
    "check:error-retry": "node scripts/check-error-state-retry.mjs",
    "check:section18": "node scripts/check-section18-gates.mjs",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "test:accounting-invariants": "vitest run src/lib/accounting/journal-line-review.test.ts src/lib/accounting/posted-gl-evidence.test.ts src/lib/accounting/payroll-payment-gl-audit.test.ts src/lib/accounting/fixed-asset-posting-evidence.test.ts",
    "verify:advisors": "node scripts/verify-advisors.mjs",
    "test:public-ui": "playwright test --config playwright.public-ui.config.ts",
    "test:create-panels": "playwright test --config playwright.create-panels.config.ts",
    "openapi:billing": "UPDATE_OPENAPI=1 vitest run src/lib/billing/api/v1/router.test.ts",
    "test:billing:e2e": "playwright test --config playwright.billing.config.ts",
    "test:purchase-orders:postgres": "node scripts/test-purchase-orders-postgres.mjs",
    "test:purchase-orders:e2e": "playwright test --config playwright.purchase-orders.config.ts",
    "test:banking:postgres": "node scripts/test-coding-memory-postgres.mjs",
    "test:banking:ui": "playwright test --config playwright.coding-memory.config.ts",
    "check:migrations": "node scripts/check-migration-identities.mjs && node --test scripts/check-migration-identities.test.mjs scripts/check-migration-history.test.mjs",
    "check:migration-history": "node scripts/check-migration-history.mjs",
    "test:banking:local-api": "python3 scripts/test-banking-local-api.py",
    "test:banking:local-ui": "playwright test --config playwright.banking-local-api.config.ts",
    "dev:banking:local": "python3 scripts/start-banking-local-app.py"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
